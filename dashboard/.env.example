# Copy this file to .env (in dashboard/) and fill in what you need.
# Nothing here is required: every variable has a sane default and the app
# works without it. Vite bakes VITE_* variables at BUILD time (import.meta.env),
# so changing them requires restarting the dev server / rebuilding.

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------

# Public base URL of the backend API. Empty = same-origin (relative /api paths,
# proxied in dev by vite.config.js and in prod by nginx). Only set it when the
# dashboard is served from a different origin than the API.
# VITE_API_URL=https://api.openshorts.app

# Local dev only: where the Vite dev proxy forwards /api and /videos.
# Defaults to http://backend:8000 (the docker-compose service name). When
# running the dev server on the host against a backend on localhost:
# VITE_PROXY_TARGET=http://localhost:8000

# Local dev only: where the Vite dev proxy forwards /renderer.
# Defaults to http://renderer:3100.
# VITE_RENDER_TARGET=http://renderer:3100

# Client-side secret used to obfuscate stored credentials in the browser.
# WARNING: anything shipped to the browser is, by definition, not secret —
# this only keeps casual snooping out. Change it from the default.
# VITE_ENCRYPTION_KEY=change-me

# ---------------------------------------------------------------------------
# Product analytics (OpenPanel) — optional, off by default
# ---------------------------------------------------------------------------

# Leave both unset and no analytics script is loaded and nothing is
# initialised (this also silences the "%VITE_OPENPANEL_*% is not defined"
# warnings Vite prints when they are unset — they are expected and harmless).
# To collect analytics for your own deployment, point both at your own
# OpenPanel instance AND add your hostname to ANALYTICS_HOSTS in index.html.
# VITE_OPENPANEL_API_URL=https://api.openpanel.example.com
# VITE_OPENPANEL_CLIENT_ID=your_openpanel_client_id
